{
  "name": "CAPMLearn01",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/audit-logging": ">=0",
    "@cap-js/hana": "^3",
    "@cap-js/notifications": "*",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^9.9.6",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-bookstore-listview": "cds watch --open bookstorelistview/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      },
      "messaging": {
        "kind": "enterprise-messaging"
      },
      "connectivity": true,
      "destinations": true,
      "html5-repo": true,
      "portal": true,
      "application-logging": true
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/bookstore-listview"
  ]
}
